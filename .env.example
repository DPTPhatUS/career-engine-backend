APP_NAME=Career Engine Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_engine

FRONTEND_ORIGIN=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/login/callback

GITHUB_API_BASE_URL=https://api.github.com
# Optional token for GitHub metadata API access and private repository visibility
GITHUB_TOKEN=

PROJECT_AUTOFILL_LLM_PROVIDER=mistral
PROJECT_AUTOFILL_MISTRAL_MODEL=mistral-small-latest
PROJECT_AUTOFILL_OPENAI_MODEL=gpt-5-nano
PROJECT_AUTOFILL_GEMINI_MODEL=gemini-2.5-flash
PROJECT_AUTOFILL_LLM_TEMPERATURE=0.2
PROJECT_AUTOFILL_LLM_TIMEOUT_SECONDS=45
PROJECT_AUTOFILL_HTTP_TIMEOUT_SECONDS=20
PROJECT_AUTOFILL_AGENT_WORKSPACE_DIR=.codexpert
PROJECT_AUTOFILL_AGENT_TOP_K=5
PROJECT_AUTOFILL_AGENT_MAX_ITERATIONS=6

MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

SESSION_COOKIE_NAME=ce_session
SESSION_TTL_SECONDS=3600
SESSION_RENEWAL_WINDOW_SECONDS=900
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-a-fernet-key
