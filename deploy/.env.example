# Copy to .env in the backend repository root for compose.yaml.
API_DOMAIN=api.career-engine.com
FRONTEND_ORIGIN=https://career-engine.com
ACME_EMAIL=

# Supabase: Connect > Session pooler, port 5432 (IPv4 compatible).
# Use the exact host and username shown in your project's dashboard.
# Change postgresql:// to postgresql+asyncpg:// and use ?ssl=require.
# Percent-encode reserved characters in the password.
# Do not use the transaction pooler on port 6543 with this configuration.
DATABASE_URL=

# Reuse the previous backend's key if this database has saved Google credentials.
# For a new key: python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
ENCRYPTION_KEY=

# Reuse your Google Web application client; register the API callbacks in the guide.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional until testing AI features. Supply the selected provider's API key.
PROJECT_AUTOFILL_LLM_PROVIDER=mistral
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional GitHub metadata API token; separate from Git clone authentication.
GITHUB_TOKEN=
